# Copy this file to .env and adjust the values.

# --- Local (non-Docker) -----------------------------------------------------
# Used when running the Django apps directly. Compose overrides these.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure

# --- Shared -----------------------------------------------------------------
# Host folder mounted into both containers. The manager gets it read-write;
# the browser gets the same folder read-only.
KWC_WALLPAPER_HOST_DIR=./data/wallpapers

# Host folder for the manager's SQLite database.
KWC_MANAGER_DATA_DIR=./data/manager

# Host user/group used by the containers so files written by the manager stay
# owned by you. On Linux, use `id -u` and `id -g`.
KWC_UID=1000
KWC_GID=1000

# Image tags used by docker-compose.yml.
BROWSER_TAG=latest
MANAGER_TAG=latest

# --- Browser ----------------------------------------------------------------
BROWSER_PORT=8080
# Required by docker-compose.yml. Generate with: openssl rand -hex 32
BROWSER_SECRET_KEY=
BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, e.g. https://wallpapers.example.com
BROWSER_CSRF_TRUSTED_ORIGINS=
# Set to true when TLS is terminated by a reverse proxy.
BROWSER_BEHIND_PROXY=false

# --- Manager ----------------------------------------------------------------
# Bind to localhost until OIDC and a reverse proxy are in place.
MANAGER_BIND=127.0.0.1
MANAGER_PORT=8081
# Required by docker-compose.yml. Generate with: openssl rand -hex 32
MANAGER_SECRET_KEY=
MANAGER_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, e.g. https://manage.example.com
MANAGER_CSRF_TRUSTED_ORIGINS=
# Set to true when TLS is terminated by a reverse proxy.
MANAGER_BEHIND_PROXY=false
# SQLite is fine with a single worker; raise this after moving to Postgres.
MANAGER_WEB_CONCURRENCY=1

# Manager email (used by allauth/OIDC later). Production defaults to SMTP.
# MANAGER_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MANAGER_EMAIL_HOST=localhost
MANAGER_EMAIL_PORT=25
MANAGER_EMAIL_HOST_USER=
MANAGER_EMAIL_HOST_PASSWORD=
MANAGER_EMAIL_USE_TLS=false
MANAGER_DEFAULT_FROM_EMAIL=kwc@localhost
